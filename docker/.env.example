# Every value here has a working dev default in docker-compose.yml.
# Copy to .env at the repo root only when you need to override one.

NEO4J_PASSWORD=multirotors_dev
MYSQL_PASSWORD=multirotors_dev
TEMPORAL_NAMESPACE=multirotors
TEMPORAL_RETENTION_DAYS=30
CATALOG_SYNC_MINUTES=15
GRAPH_WORKER_REPLICAS=1

SHOPIFY_STORE_DOMAIN=multirotors.store

# Postgres for conversations/messages (Drizzle). Not provided by compose —
# point at your existing instance.
DATABASE_URL=

OPENAI_API_KEY=

# Observability. Leave the endpoint on Phoenix for local dev; set the Arize
# pair to ship traces to Arize AX instead.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.arize.com/v1/traces
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_MODEL_ID=multirotors-configurator
