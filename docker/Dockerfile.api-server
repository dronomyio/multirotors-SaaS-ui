# Express API server + Mastra agent.
#
# pnpm workspace, so the build context is the repo root and only the manifests
# that affect resolution are copied before install.

FROM node:24-slim AS base
ENV PNPM_HOME=/pnpm PATH="/pnpm:$PATH"
RUN corepack enable
WORKDIR /repo


FROM base AS deps

# Manifests only — a source edit must not bust the install layer.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY lib/api-spec/package.json          lib/api-spec/
COPY lib/api-zod/package.json           lib/api-zod/
COPY lib/api-client-react/package.json  lib/api-client-react/
COPY lib/contracts/package.json         lib/contracts/
COPY lib/mastra/package.json            lib/mastra/
COPY lib/db/package.json                lib/db/
COPY artifacts/api-server/package.json  artifacts/api-server/

# The workspace sets minimumReleaseAge: 1440 as supply-chain defence. Keep the
# store mounted rather than disabling that.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @workspace/api-server...


FROM deps AS build
COPY tsconfig.base.json tsconfig.json ./
COPY lib ./lib
COPY artifacts/api-server ./artifacts/api-server
RUN pnpm --filter @workspace/api-server run build


FROM node:24-slim AS runtime
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
WORKDIR /app

COPY --from=build --chown=app:app /repo/artifacts/api-server/dist ./dist
COPY --from=build --chown=app:app /repo/node_modules ./node_modules

ENV NODE_ENV=production PORT=5000
EXPOSE 5000
USER app

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://localhost:'+(process.env.PORT||5000)+'/api/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
